{
  "manifest_version": 3,
  "name": "AI Form Auto-Fill",
  "version": "1.0.0",
  "description": "使用AI自动填写网页表单",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
