import UnicodeConverter from '../../../islands/unicode_converter'
import MorseCode from '../../../islands/morse_code'
import UrlParser from '../../../islands/url_parser'
import JsonSchema from '../../../islands/json_schema'
import RegexVisual from '../../../islands/regex_visual'
import FontCompare from '../../../islands/font_compare'
import Base32Codec from '../../../islands/base32_codec'
import JwtGenerator from '../../../islands/jwt_generator'
import HtmlToJsx from '../../../islands/html_to_jsx'
import CssToTailwind from '../../../islands/css_to_tailwind'
import CsvToJson from '../../../islands/csv_to_json'
import JsonToCsv from '../../../islands/json_to_csv'
import XmlFormatter from '../../../islands/xml_formatter'
import ProtobufViewer from '../../../islands/protobuf_viewer'
import PasswordStrength from '../../../islands/password_strength'
import DockerCompose from '../../../islands/docker_compose'
import NginxConfig from '../../../islands/nginx_config'
import GitCommit from '../../../islands/git_commit'
import JsonPrettier from '../../../islands/json_prettier'
import IpLookup from '../../../islands/ip_lookup'
import ClipboardHistory from '../../../islands/clipboard_history'
import Base64ToImage from '../../../islands/base64_to_image'
import JsonToEnv from '../../../islands/json_to_env'
import CodeMinifier from '../../../islands/code_minifier'
import ColorPalette from '../../../islands/color_palette'
import EmojiPicker from '../../../islands/emoji_picker'
import MarkdownToHtml from '../../../islands/markdown_to_html'
import PlaceholderImage from '../../../islands/placeholder_image'
import MarkdownTable from '../../../islands/markdown_table'
import QrReader from '../../../islands/qr_reader'
import QrGenerator from '../../../islands/qr_generator'
import DateTimeTool from '../../../islands/datetime_tool'
import TextStats from '../../../islands/text_stats'
import NumberConverter from '../../../islands/number_converter'
import UuidGenerator from '../../../islands/uuid_generator'
import LoremGenerator from '../../../islands/lorem_generator'
import ImageCompressor from '../../../islands/image_compressor'
import ImageConverter from '../../../islands/image_converter'
import ImageCropper from '../../../islands/image_cropper'
import ImageMetadata from '../../../islands/image_metadata'
import ImageSlicer from '../../../islands/image_slicer'
import PdfMerger from '../../../islands/pdf_merger'
import PdfSplitter from '../../../islands/pdf_splitter'
import DocxConverter from '../../../islands/docx_converter'
import XlsxConverter from '../../../islands/xlsx_converter'
import CsvViewer from '../../../islands/csv_viewer'
import ZipViewer from '../../../islands/zip_viewer'

export function getStaticPaths() {
  const paths = []
  for (const lang of locales) {
    for (const tool of tools) {
      paths.push({
        params: { lang, slug: tool.slug },
        props: { tool },
      })
    }
  }
  return paths
}

const { lang } = Astro.params
const { tool } = Astro.props
const toolName = t(lang, tool.titleKey)
const toolDesc = t(lang, tool.descKey)
const slug = tool.slug
---

<Layout title={`${toolName} - ToolBox`} lang={lang}>
  <Header lang={lang} />
  <main>
    <ToolPage title={toolName} description={toolDesc}>
      {slug === 'json-formatter' && <JsonFormatter client:load />}
      {slug === 'base64-codec' && <Base64Codec client:load />}
      {slug === 'url-codec' && <UrlCodec client:load />}
      {slug === 'markdown-preview' && <MarkdownPreview client:load />}
      {slug === 'regex-tester' && <RegexTester client:load />}
      {slug === 'yaml-formatter' && <YamlFormatter client:load />}
      {slug === 'text-diff' && <TextDiff client:load />}
      {slug === 'hash-generator' && <HashGenerator client:load />}
      {slug === 'jwt-decoder' && <JwtDecoder client:load />}
      {slug === 'color-converter' && <ColorConverter client:load />}
      {slug === 'css-unit-converter' && <CssUnitConverter client:load />}
      {slug === 'password-generator' && <PasswordGenerator client:load />}
      {slug === 'cron-parser' && <CronParser client:load />}
      {slug === 'json-to-ts' && <JsonToTs client:load />}
      {slug === 'svg-viewer' && <SvgViewer client:load />}
      {slug === 'text-case' && <TextCase client:load />}
      {slug === 'html-entity' && <HtmlEntity client:load />}
      {slug === 'image-to-base64' && <ImageToBase64 client:load />}
      {slug === 'css-gradient' && <CssGradient client:load />}
      {slug === 'contrast-checker' && <ContrastChecker client:load />}
      {slug === 'api-tester' && <ApiTester client:load />}
      {slug === 'sql-formatter' && <SqlFormatter client:load />}
      {slug === 'yaml-json' && <YamlJson client:load />}
      {slug === 'css-grid' && <CssGrid client:load />}
      {slug === 'box-shadow' && <BoxShadow client:load />}
      {slug === 'css-animation' && <CssAnimation client:load />}
      {slug === 'unicode-converter' && <UnicodeConverter client:load />}
      {slug === 'morse-code' && <MorseCode client:load />}
      {slug === 'url-parser' && <UrlParser client:load />}
      {slug === 'json-schema' && <JsonSchema client:load />}
      {slug === 'regex-visual' && <RegexVisual client:load />}
      {slug === 'font-compare' && <FontCompare client:load />}
      {slug === 'base32-codec' && <Base32Codec client:load />}
      {slug === 'jwt-generator' && <JwtGenerator client:load />}
      {slug === 'html-to-jsx' && <HtmlToJsx client:load />}
      {slug === 'css-to-tailwind' && <CssToTailwind client:load />}
      {slug === 'csv-to-json' && <CsvToJson client:load />}
      {slug === 'json-to-csv' && <JsonToCsv client:load />}
      {slug === 'xml-formatter' && <XmlFormatter client:load />}
      {slug === 'protobuf-viewer' && <ProtobufViewer client:load />}
      {slug === 'password-strength' && <PasswordStrength client:load />}
      {slug === 'docker-compose' && <DockerCompose client:load />}
      {slug === 'nginx-config' && <NginxConfig client:load />}
      {slug === 'git-commit' && <GitCommit client:load />}
      {slug === 'json-prettier-enhanced' && <JsonPrettier client:load />}
      {slug === 'ip-lookup' && <IpLookup client:load />}
      {slug === 'clipboard-history' && <ClipboardHistory client:load />}
      {slug === 'base64-to-image' && <Base64ToImage client:load />}
      {slug === 'json-to-env' && <JsonToEnv client:load />}
      {slug === 'code-minifier' && <CodeMinifier client:load />}
      {slug === 'color-palette' && <ColorPalette client:load />}
      {slug === 'emoji-picker' && <EmojiPicker client:load />}
      {slug === 'markdown-to-html' && <MarkdownToHtml client:load />}
      {slug === 'placeholder-image' && <PlaceholderImage client:load />}
      {slug === 'markdown-table' && <MarkdownTable client:load />}
      {slug === 'qr-reader' && <QrReader client:load />}
      {slug === 'qr-generator' && <QrGenerator client:load />}
      {slug === 'datetime-tool' && <DateTimeTool client:load />}
      {slug === 'text-stats' && <TextStats client:load />}
      {slug === 'number-converter' && <NumberConverter client:load />}
      {slug === 'uuid-generator' && <UuidGenerator client:load />}
      {slug === 'lorem-generator' && <LoremGenerator client:load />}
      {slug === 'image-compressor' && <ImageCompressor client:load />}
      {slug === 'image-converter' && <ImageConverter client:load />}
      {slug === 'image-cropper' && <ImageCropper client:load />}
      {slug === 'image-metadata' && <ImageMetadata client:load />}
      {slug === 'image-slicer' && <ImageSlicer client:load />}
      {slug === 'pdf-merger' && <PdfMerger client:load />}
      {slug === 'pdf-splitter' && <PdfSplitter client:load />}
      {slug === 'docx-converter' && <DocxConverter client:load />}
      {slug === 'xlsx-converter' && <XlsxConverter client:load />}
      {slug === 'csv-viewer' && <CsvViewer client:load />}
      {slug === 'zip-viewer' && <ZipViewer client:load />}
    </ToolPage>
  </main>
  <Footer />
</Layout>
